---
import Layout from "../layouts/Layout.astro";
import ForgotPasswordForm from "../components/ForgotPasswordForm.svelte";
import { site } from "../data/site";
---

<Layout title={`Reset password — ${site.name}`} description="Reset your kleinbem.dev password.">
  <section class="mx-auto max-w-sm px-6 pt-20 pb-16">
    <h1 class="text-2xl font-semibold tracking-tight text-heading">Reset password</h1>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">
      Enter your email and we'll send you a reset link.
    </p>
    <div class="mt-8">
      <ForgotPasswordForm client:visible />
    </div>
  </section>
</Layout>
