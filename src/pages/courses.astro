---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { courses } from "../data/courses";

const statusStyle: Record<string, string> = {
  Available: "border-accent/40 bg-accent-soft text-accent",
  "In development": "border-line text-muted",
  "Coming soon": "border-line text-muted",
};
---

<Layout title={`Courses — ${site.name}`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-12">
    <h1 class="text-3xl font-semibold tracking-tight text-heading sm:text-4xl">Courses</h1>
    <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-muted">
      Structured, practical courses on infrastructure automation and platform engineering.
      Content is still being written — the list below is a placeholder for what's coming.
    </p>

    <div class="mt-10 grid gap-4">
      {courses.map((course) => (
        <article class="rounded-xl border border-line bg-surface p-6 transition-colors hover:border-accent/40">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <h2 class="font-medium text-heading">{course.title}</h2>
            <span
              class:list={[
                "rounded-full border px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide",
                statusStyle[course.status],
              ]}
            >
              {course.status}
            </span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-muted">{course.description}</p>
        </article>
      ))}
    </div>

    <div class="mt-12 rounded-xl border border-line bg-surface p-6">
      <p class="text-[15px] text-fg">Want to know when a course ships?</p>
      <p class="mt-1 text-sm text-muted">
        Course announcements go out on the newsletter first.
      </p>
      <a
        href="https://kleinbem.substack.com"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-medium text-accent-fg transition-colors hover:bg-accent-hover"
      >
        Subscribe on Substack
      </a>
    </div>
  </section>
</Layout>
