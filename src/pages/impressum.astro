---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title={`Impressum — ${site.name}`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-12">
    <h1 class="text-3xl font-semibold tracking-tight text-heading sm:text-4xl">Impressum</h1>
    <p class="mt-4 max-w-2xl rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm leading-relaxed text-amber-700">
      Placeholder — fill in the fields your jurisdiction legally requires (e.g. §5 TMG /
      §25 MedienG / Art. 3 UWG depending on country) before publishing. This is not legal advice.
    </p>

    <dl class="mt-10 grid gap-6 text-sm sm:grid-cols-[12rem_1fr]">
      <dt class="font-mono text-xs uppercase tracking-wider text-muted">Responsible for content</dt>
      <dd class="text-fg">{site.name}</dd>

      <dt class="font-mono text-xs uppercase tracking-wider text-muted">Address</dt>
      <dd class="text-fg">Street, ZIP, City, Country</dd>

      <dt class="font-mono text-xs uppercase tracking-wider text-muted">Contact</dt>
      <dd>
        <a
          href={`mailto:${site.email}`}
          class="text-heading underline decoration-line underline-offset-4 transition-colors hover:decoration-accent"
        >
          {site.email}
        </a>
      </dd>

      <dt class="font-mono text-xs uppercase tracking-wider text-muted">VAT ID / Business registration</dt>
      <dd class="text-fg">Add if applicable (e.g. USt-IdNr., Gewerbeschein, UID)</dd>
    </dl>
  </section>
</Layout>
