---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title={`Impressum — ${site.name}`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-12">
    <h1 class="text-3xl font-semibold tracking-tight text-slate-50">Impressum</h1>
    <p class="mt-3 text-sm text-amber-400/90 max-w-2xl">
      Placeholder — fill in the fields your jurisdiction legally requires (e.g. §5 TMG /
      §25 MedienG / Art. 3 UWG depending on country) before publishing. This is not legal advice.
    </p>

    <dl class="mt-8 space-y-4 text-sm text-slate-300">
      <div>
        <dt class="text-slate-500">Responsible for content</dt>
        <dd>{site.name}</dd>
      </div>
      <div>
        <dt class="text-slate-500">Address</dt>
        <dd>Street, ZIP, City, Country</dd>
      </div>
      <div>
        <dt class="text-slate-500">Contact</dt>
        <dd>
          <a href={`mailto:${site.email}`} class="underline underline-offset-4 hover:text-white">
            {site.email}
          </a>
        </dd>
      </div>
      <div>
        <dt class="text-slate-500">VAT ID / Business registration</dt>
        <dd>Add if applicable (e.g. USt-IdNr., Gewerbeschein, UID)</dd>
      </div>
    </dl>
  </section>
</Layout>
