---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const services = [
  {
    title: "Infrastructure Automation",
    description:
      "Reproducible system configuration, CI/CD pipelines, and deployment automation that cuts manual toil.",
  },
  {
    title: "Platform & DevOps Consulting",
    description:
      "Advisory and hands-on work to make your infrastructure more reliable, observable, and easier to maintain.",
  },
  {
    title: "Migration & Modernization",
    description:
      "Moving legacy setups to reproducible, version-controlled infrastructure with minimal downtime.",
  },
];
---

<Layout title={`Services — ${site.name}`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-12">
    <h1 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Services</h1>
    <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-ink-300">
      Engagements are scoped as retainers, fixed-scope projects, or one-off audits — whatever
      fits the problem. A short call is the fastest way to find out if it's a fit.
    </p>

    <div class="mt-10 grid gap-4">
      {services.map((service) => (
        <article class="rounded-xl border border-ink-800 bg-ink-900/40 p-6 transition-colors hover:border-ink-700">
          <h2 class="font-medium text-ink-100">{service.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-300">{service.description}</p>
        </article>
      ))}
    </div>

    <div class="mt-12 rounded-xl border border-ink-800 bg-ink-900/40 p-6">
      <p class="text-[15px] text-ink-200">Ready to talk?</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-3 inline-flex items-center rounded-lg bg-accent-500 px-4 py-2 text-sm font-medium text-ink-950 transition-colors hover:bg-accent-400"
      >
        Get in touch
      </a>
    </div>
  </section>
</Layout>
