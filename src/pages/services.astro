---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { services } from "../data/services";
---

<Layout
  title={`Services — ${site.name}`}
  description="Infrastructure automation, platform & DevOps consulting, and migration & modernization services."
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-12">
    <h1 class="text-3xl font-semibold tracking-tight text-heading sm:text-4xl">Services</h1>
    <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-muted">
      Engagements are scoped as retainers, fixed-scope projects, or one-off audits — whatever
      fits the problem. A short call is the fastest way to find out if it's a fit.
    </p>

    <div class="mt-10 grid gap-4">
      {services.map((service) => (
        <article class="rounded-xl bg-surface p-6 shadow-elevation-1 transition-shadow hover:shadow-elevation-2">
          <h2 class="font-medium text-heading">{service.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">{service.description}</p>
        </article>
      ))}
    </div>

    <div class="mt-12 rounded-xl bg-accent-soft p-6">
      <p class="text-[15px] text-accent-soft-fg">Ready to talk?</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-3 inline-flex items-center rounded-full bg-accent px-6 py-2.5 text-sm font-medium text-accent-fg transition-[background-color,box-shadow] hover:bg-accent-hover hover:shadow-elevation-1"
      >
        Get in touch
      </a>
    </div>
  </section>
</Layout>
