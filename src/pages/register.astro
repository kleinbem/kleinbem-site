---
import Layout from "../layouts/Layout.astro";
import RegisterForm from "../components/RegisterForm.svelte";
import { site } from "../data/site";
---

<Layout title={`Create account — ${site.name}`} description="Create an account on kleinbem.dev." noindex>
  <section class="mx-auto max-w-sm px-6 pt-20 pb-16">
    <h1 class="text-2xl font-semibold tracking-tight text-heading">Create account</h1>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">
      Or <a href="/login" class="text-heading underline">sign in</a> if you already have one.
    </p>
    <div class="mt-8">
      <RegisterForm client:visible />
    </div>
  </section>
</Layout>
