---
import Layout from "../layouts/Layout.astro";
import ResetPasswordForm from "../components/ResetPasswordForm.svelte";
import { site } from "../data/site";
---

<Layout title={`Set new password — ${site.name}`} description="Set a new kleinbem.dev password.">
  <section class="mx-auto max-w-sm px-6 pt-20 pb-16">
    <h1 class="text-2xl font-semibold tracking-tight text-heading">Set new password</h1>
    <div class="mt-8">
      <ResetPasswordForm client:visible />
    </div>
  </section>
</Layout>
