---
import Layout from "../layouts/Layout.astro";
import LoginProviders from "../components/LoginProviders.svelte";
import { site } from "../data/site";

// Email+password (register/forgot-password) is built (EmailPasswordForm,
// RegisterForm, /register, /forgot-password, /reset-password) but not linked
// from here yet — it needs an SMTP mailbox for kleinbem-auth to send from,
// which isn't set up. Add the form + "Create one" link back once that exists.
---

<Layout title={`Sign in — ${site.name}`} description="Sign in to kleinbem.dev.">
  <section class="mx-auto max-w-sm px-6 pt-20 pb-16">
    <h1 class="text-2xl font-semibold tracking-tight text-heading">Sign in</h1>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">
      Choose a provider to continue.
    </p>
    <div class="mt-8">
      <LoginProviders client:visible />
    </div>
  </section>
</Layout>
