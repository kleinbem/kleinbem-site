---
import Layout from "../layouts/Layout.astro";
import LoginProviders from "../components/LoginProviders.svelte";
import EmailPasswordForm from "../components/EmailPasswordForm.svelte";
import { site } from "../data/site";
---

<Layout title={`Sign in — ${site.name}`} description="Sign in to kleinbem.dev." noindex>
  <section class="mx-auto max-w-sm px-6 pt-20 pb-16">
    <h1 class="text-2xl font-semibold tracking-tight text-heading">Sign in</h1>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">
      Choose a provider, or use your email and password.
    </p>
    <div class="mt-8">
      <LoginProviders client:visible />
    </div>

    <div class="my-6 flex items-center gap-3">
      <div class="h-px flex-1 bg-line"></div>
      <span class="text-xs text-muted">or</span>
      <div class="h-px flex-1 bg-line"></div>
    </div>

    <EmailPasswordForm client:visible />

    <p class="mt-6 text-center text-xs text-muted">
      Don't have an account? <a href="/register" class="text-heading underline">Create one</a>.
    </p>
  </section>
</Layout>
